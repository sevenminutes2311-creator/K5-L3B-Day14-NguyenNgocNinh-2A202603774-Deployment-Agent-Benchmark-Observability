# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env
# File .env đã nằm trong .gitignore — KHÔNG commit .env.
# Không ghi secret thật vào file này.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Bắt buộc: API key client phải gửi trong header X-API-Key.
# Để trống thì mọi request /ask đều bị 401. Tạo key ngẫu nhiên, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis cho rate limit + cost guard. Trong docker compose đã được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Budget chi phí LLM mỗi ngày cho mỗi API key (USD)
DAILY_BUDGET_USD=1.0
